# Replica flavour — scitex-compute-01. Copy to ~/.scitex/pg/replica.env.
#
# ONLY TWO VALUES ARE GENUINELY PER-HOST: the replication slot name and this
# host's own overlay address. Everything else is identical on all four replicas.
# Measured 2026-08-27 across compute-01..04.
#
# Values are QUOTED: this file is read by systemd AND sourced by the setup
# script, and bash word-splits what systemd tolerates unquoted.
SCITEX_PG_DATADIR="/home/ywatanabe/.scitex/pg/18/main"
SCITEX_PG_SIF="/home/ywatanabe/.scitex/pg/postgres18.sif"
SCITEX_PG_BIND="/home/ywatanabe:/home/ywatanabe"
SCITEX_PG_PORT="55432"

# PER-HOST #1 — this replica's slot on the primary. Must already exist there:
#   SELECT pg_create_physical_replication_slot('replica_c01');
# A slot is what makes a partition self-healing — the primary RETAINS WAL for a
# disconnected replica, so it catches up on return instead of needing a rebuild.
# That retention is also the risk: a replica gone for good pins WAL forever and
# fills the primary's disk. Drop the slot when you retire a replica.
SCITEX_PG_SLOT="replica_c01"

# PER-HOST #2 — this host's own overlay address, never another's.
SCITEX_PG_LISTEN="127.0.0.1,100.64.0.2"

# The primary is named, not addressed. `scitex-primary` MUST resolve on this
# host (/etc/hosts or DNS) — it is a PRECONDITION, not an incidental. When it
# stops resolving, replication stops with an error that reads like a network
# fault rather than a configuration one.
SCITEX_PG_PRIMARY_HOST="scitex-primary"
SCITEX_PG_REPL_USER="svc_replica"
