[Unit]
Description=Record a durable ALERT when %i failed — the consumer for the backup lanes' red
Documentation=https://github.com/scitex-ai/scitex-db

# WHAT THIS IS, STATED HONESTLY (constitution §2).
#
# The wal-sync, dump and drill units all fail correctly and loudly — into a
# journal nobody polls. "A check whose failure nothing reads is not a check."
# So this template exists to give that red a reader.
#
# It is a RECORD PLUS A POLLING CONSUMER, **not** a push gate. Say which one
# you built and never count a record as a gate:
#   - the RECORD is alerts.log below, appended on every failure, durable and
#     greppable, with the unit name and the last journal lines;
#   - the CONSUMER is the scitex-agent-container agent's hourly check, which
#     reads this file over ssh. Named, scheduled, and real.
#
# A card-raising version was drafted first and DISCARDED: scitex-cards is not
# installed on nas-03 (measured 2026-08-27 — absent from PATH, ~/.local/bin and
# /opt/venv-sac), so a unit shelling it would have been a gate incapable of
# firing, which is worse than no gate because the unit file would still claim
# one. Installing scitex-cards on nas-03 is the carded follow-up that upgrades
# this record into a push gate.
#
# It is a systemd OnFailure= dependency rather than a check inside each script
# on purpose: a script that must remember to report its own failure cannot
# report the failure of never having run.

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'mkdir -p %h/.scitex/pg/logs; \
  { echo "=== $(date -u +%%Y-%%m-%%dT%%H:%%M:%%SZ) ALERT unit=%i host=$(hostname -s)"; \
    journalctl --user -u %i -n 15 --no-pager 2>/dev/null | tail -15; \
    echo; } >> %h/.scitex/pg/logs/alerts.log'
