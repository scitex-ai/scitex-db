# Nightly dump lane — scitex-nas-03 flavour. Copy to ~/.scitex/pg/dump.env.
# The exec prefix IS the mechanism parameter: docker here, apptainer elsewhere.
SCITEX_PG_EXEC=docker exec -u 70 -e PGPASSFILE=/var/lib/postgresql/.pgpass scitex-pg18
SCITEX_PG_DUMP_DIR=/home/ywatanabe/.scitex/pg/backups/daily
SCITEX_PG_OFFSITE_HOST=ywatanabe@scitex-nas-02
SCITEX_PG_OFFSITE_DUMP_PATH=pg-backups/nas-03/dumps
SCITEX_PG_DUMP_DBS=scitex_cards headscale scitex
SCITEX_PG_SSH_KEY=/home/ywatanabe/.ssh/id_mesh
SCITEX_PG_PORT=55432
