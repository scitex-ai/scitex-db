# Nightly dump + restore drill — scitex-nas-03 flavour.
# Copy to ~/.scitex/pg/dump.env.
#
# VALUES ARE QUOTED ON PURPOSE. This file has TWO consumers: systemd
# (EnvironmentFile=) and a plain shell (`set -a; . dump.env`) when a human or
# the drill runs the lane by hand. systemd tolerates unquoted spaces; bash does
# NOT — it word-splits, so an unquoted `SCITEX_PG_EXEC=docker exec -u 70 ...`
# makes the shell run `exec -u 70`, and an unquoted DB list makes it run
# `headscale`. Measured 2026-08-27, both, on the first drill invocation.
# Quoting satisfies both readers; systemd strips the quotes.
SCITEX_PG_EXEC="docker exec -u 70 -e PGPASSFILE=/var/lib/postgresql/.pgpass scitex-pg18"
SCITEX_PG_DUMP_DIR="/home/ywatanabe/.scitex/pg/backups/daily"
SCITEX_PG_OFFSITE_HOST="ywatanabe@scitex-nas-02"
SCITEX_PG_OFFSITE_DUMP_PATH="pg-backups/nas-03/dumps"
SCITEX_PG_DUMP_DBS="scitex_cards headscale scitex"
SCITEX_PG_SSH_KEY="/home/ywatanabe/.ssh/id_mesh"
SCITEX_PG_PORT="55432"
SCITEX_PG_LIVE_CONTAINER="scitex-pg18"
SCITEX_PG_DRILL_PORT="55499"
