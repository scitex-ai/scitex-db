# Primary WAL offsite lane — scitex-nas-03 flavour. Copy to
# ~/.scitex/pg/wal-sync.env and adjust. Values are SHAPES, not secrets.
SCITEX_PG_ARCHIVE_DIR=/home/ywatanabe/.scitex/pg/wal-archive
SCITEX_PG_OFFSITE_HOST=ywatanabe@scitex-nas-02
SCITEX_PG_OFFSITE_PATH=pg-backups/nas-03/wal-archive
# nas-03's ssh config picks the wrong identity for the alias; be explicit.
SCITEX_PG_SSH_KEY=/home/ywatanabe/.ssh/id_mesh
# The archive dir is owned by the container's postgres uid (70), unreadable to
# the login user. NOPASSWD sudo (or the local sudo.pw mechanism) covers it.
SCITEX_PG_SUDO=/usr/bin/sudo -n
# Reads the primary's archiver as key=value lines (in_recovery, archive_mode,
# failed_count, age_min, timeline_now, timeline_archived).
SCITEX_PG_ARCHIVER_STATUS=/home/ywatanabe/.scitex/pg/archiver_status.sh
SCITEX_PG_KEEP_DAYS=14
SCITEX_PG_ARCHIVE_STALE_MIN=30
