# The primary on scitex-nas-03. Copy to `.env` beside docker-compose.yml.
# Values here are EXAMPLES of shape, not secrets.
SCITEX_PG_DATA=/home/ywatanabe/.scitex/pg/cards18
SCITEX_PG_WAL_ARCHIVE=/home/ywatanabe/.scitex/pg/wal-archive
SCITEX_PG_PGPASS=/home/ywatanabe/pgpass-nas03/.pgpass
SCITEX_PG_PORT=55432
# loopback, the overlay address, and the LAN address, in that spirit:
# local agents, VPN peers, and same-LAN hosts. Adjust per host.
SCITEX_PG_LISTEN=127.0.0.1,100.64.0.5,192.168.11.133
