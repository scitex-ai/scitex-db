MANIFEST

docs/sphinx/_build/

# Sphinx's incremental-build cache. Not part of the published HTML, and it
# is not merely redundant: environment.pickle embeds the ABSOLUTE build
# directory and a copy of every intersphinx inventory (the whole CPython
# object index), so committing it makes the bundle depend on who built it
# and on which machine.
src/*/_sphinx_html/.doctrees/

# Coverage artifacts (combined + parallel shards)
.coverage
.coverage.*

# .scitex/ is a local-state directory; only the tracked config is committed.
.scitex/*
!.scitex/dev/
.scitex/dev/*
!.scitex/dev/config.yaml

# Python virtualenv
.venv/
.worktrees/
